{
  "name": "bytesplit",
  "version": "1.1.0",
  "description": "ByteSplit",
  "author": "Muhammad Syahrin Harahap",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bytesplit.app",
    "productName": "ByteSplit",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
